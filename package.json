{
  "name": "open-referee-js",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Static web version of open-referee — AI paper review with literature grounding, fully client-side",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paluigi/open-referee-js.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "idb": "^8.0.3",
    "mammoth": "^1.13.0",
    "marked": "^15.0.6",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "fake-indexeddb": "^6.0.1",
    "happy-dom": "^16.5.3",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
